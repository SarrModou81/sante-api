# Copier ce fichier en .env puis remplacer les valeurs (ne jamais committer .env)
FLASK_CONFIG=dev
SECRET_KEY=remplacer-par-une-longue-valeur-aleatoire
JWT_SECRET_KEY=remplacer-par-une-autre-longue-valeur-aleatoire
DATABASE_URL=sqlite:///sante.db
CORS_ORIGINS=http://localhost:3000
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
RATELIMIT_DEFAULT=200 per hour
RATELIMIT_STORAGE_URI=memory://
# Utilises par docker-compose (service PostgreSQL)
POSTGRES_USER=sante
POSTGRES_PASSWORD=passer
POSTGRES_DB=sante